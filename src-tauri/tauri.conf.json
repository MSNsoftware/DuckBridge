{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckBridge",
  "version": "0.1.3",
  "identifier": "com.duckbridge.bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DuckBridge - API Gateway",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Local Duck.ai API gateway",
    "longDescription": "DuckBridge - local OpenAI-compatible gateway for Duck.ai with tray, settings and sidecar server.",
    "resources": [
      "../server/main.py",
      "../server/duckai_backend.py",
      "../server/jsa_jsdom.js",
      "../server/package.json",
      "../server/package-lock.json",
      "../server/requirements.txt",
      "../server/website.html",
      "../server/.env.example"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGRjlFNDBFMjFBMkJGQjkKUldTNXY2SWhEdVQ1ZjdYN3VVQ3hZK2Zqcm1TSEJ6WW93Yjdqc1N1ZXVCL1FFQnFyaittREV2bGsK",
      "endpoints": ["https://github.com/MSNsoftware/DuckBridge/releases/latest/download/latest.json"],
      "dialog": true
    }
  }
}
